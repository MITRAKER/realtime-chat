# Copy to .env and adjust. Never commit .env: it holds secrets.
# Load it into your shell with:  set -a; source .env; set +a

# Where the server listens.
ADDR=:8080

# PostgreSQL connection. Leave empty to keep everything in memory.
DATABASE_URL=postgres://chat:chat@localhost:5432/chat?sslmode=disable

# Secret for signing login tokens: at least 32 characters, random.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=

# How long a login lasts.
TOKEN_TTL=24h

# Only for `go test`: a database the tests may create schemas in.
TEST_DATABASE_URL=postgres://chat:chat@localhost:5432/chat_test?sslmode=disable
